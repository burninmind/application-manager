ANTHROPIC_API_KEY=sk-ant-...

# Your name. Signs the letter and names the generated files, e.g. "Jane Doe-resume.pdf".
# Leave empty for plain "resume.pdf" / "letter.pdf" and an unsigned letter.
APPLICANT_NAME=

# How many projects and publications the tailored resume keeps (the best matches).
# RESUME_MAX_PROJECTS=3
# RESUME_MAX_PUBLICATIONS=3

# Warn in Step 1 when a job description matches a stored one at least this closely
# (share of word 3-grams of the shorter text found in the other, 0 to 1).
# DUPLICATE_THRESHOLD=0.90

# Per-step model overrides (optional). Defaults shown.
# CLAUDE_MODEL_TRANSLATE=claude-haiku-4-5
# CLAUDE_MODEL_TAILOR=claude-sonnet-5-5
# CLAUDE_MODEL_LETTER=claude-sonnet-5-5
# CLAUDE_MODEL_METADATA=claude-haiku-4-5

# Effort per step: low | medium | high | xhigh | max (ignored by models that
# don't support it, e.g. Haiku 4.5).
# CLAUDE_EFFORT_TAILOR=high
# CLAUDE_EFFORT_LETTER=high
# CLAUDE_EFFORT_TRANSLATE=low
# CLAUDE_EFFORT_METADATA=low
