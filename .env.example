ANTHROPIC_API_KEY=sk-ant-...

# Applicant name. Used to name generated files, e.g. "Ali Mahmoudi-resume.pdf".
# Leave empty to fall back to plain "resume.pdf" / "letter.pdf".
APPLICANT_NAME=

# Per-step model overrides (optional). Defaults shown.
# CLAUDE_MODEL_TRANSLATE=claude-haiku-4-5-20251001
# CLAUDE_MODEL_TAILOR=claude-sonnet-4-6
# CLAUDE_MODEL_LETTER=claude-sonnet-4-6
# CLAUDE_MODEL_METADATA=claude-haiku-4-5-20251001
